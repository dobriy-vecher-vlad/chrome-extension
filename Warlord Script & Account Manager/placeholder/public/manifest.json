{
	"manifest_version": 3,
	"minimum_chrome_version": "110",
	"name": "Warlord Script",
	"version": "3.0.0",
	"description": "Расширение переехало: установите «Warlord Script & Account Manager» из Chrome Web Store.",
	"icons": {
		"16": "icons/16.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"content_scripts": [
		{
			"matches": [
				"*://vk.com/*",
				"*://vk.ru/*"
			],
			"js": [
				"content.js"
			],
			"run_at": "document_idle"
		}
	]
}
