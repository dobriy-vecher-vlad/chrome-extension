{
	"manifest_version": 3,
	"minimum_chrome_version": "110",
	"name": "Warlord Script & Account Manager",
	"version": "4.0.0",
	"description": "Характеристики игроков на их страницах и быстрое переключение между своими аккаунтами в игре Warlord.",
	"homepage_url": "https://vk.ru/wiki.warlord",
	"icons": {
		"16": "icons/16.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"permissions": [
		"storage",
		"scripting",
		"webNavigation"
	],
	"host_permissions": [
		"https://vk.ru/*",
		"https://api.vk.ru/*",
		"https://*.geronimo.su/*",
		"https://dobriy-vecher-vlad.github.io/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"https://vk.ru/app5536422*"
			],
			"js": [
				"content.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://vk.ru/*"
			],
			"js": [
				"probe.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://warlord.geronimo.su/client/vk/*"
			],
			"js": [
				"game-frame.js"
			],
			"all_frames": true,
			"run_at": "document_start"
		}
	]
}
